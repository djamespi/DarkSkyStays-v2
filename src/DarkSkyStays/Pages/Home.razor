@page "/"

@inject SampleStayService SampleData

<PageTitle>DarkSkyStays | Prototype</PageTitle>

<section class="mx-auto max-w-6xl px-6 py-12 sm:py-20">
    <p class="text-sm font-semibold uppercase tracking-widest text-sky-300">Frontend prototype</p>
    <h1 class="mt-4 max-w-2xl text-4xl font-semibold leading-tight sm:text-5xl">A starting point for stays under the stars.</h1>
    <p class="mt-5 max-w-2xl leading-7 text-slate-300">Explore a few sample stays while the design takes shape. This starter will be updated to match the Figma project.</p>
    <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-end">
        <div class="grow">
            <label for="stay-search" class="mb-2 block text-sm font-medium">Find a sample stay</label>
            <input id="stay-search" type="search" placeholder="Search by name or location"
                   class="w-full rounded-xl border border-slate-600 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-500"
                   @bind="search" @bind:event="oninput" />
        </div>
        <button type="button" class="rounded-xl border border-slate-600 px-5 py-3 text-sm hover:bg-slate-800" @onclick="ResetFilters">Reset filters</button>
    </div>
    <div class="my-6 flex flex-wrap items-center justify-between gap-3">
        <label class="flex cursor-pointer items-center gap-2 text-sm text-slate-300">
            <input type="checkbox" class="size-4 accent-sky-300" @bind="savedOnly" />
            Show saved stays only
        </label>
        <p role="status" class="text-sm text-slate-400">@VisibleStays.Count stay(s) shown · @SampleData.SavedCount saved</p>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
        @foreach (var stay in VisibleStays)
        {
            <StayCard @key="stay.Id" Stay="stay" IsSaved="SampleData.IsSaved(stay.Id)" OnToggleSaved="() => SampleData.ToggleSaved(stay.Id)" />
        }
    </div>
    @if (VisibleStays.Count == 0)
    {
        <p class="rounded-2xl border border-dashed border-slate-700 p-10 text-center text-slate-300">No matching stays. Try another search or reset the filters.</p>
    }
    <p class="mt-8 text-xs leading-6 text-slate-500">Sample listings and USD prices for demonstration. Saved stays reset when you refresh.</p>
</section>

@code {
    private string search = string.Empty;
    private bool savedOnly;

    private IReadOnlyList<Stay> VisibleStays => SampleData.Stays
        .Where(stay => string.IsNullOrWhiteSpace(search)
            || stay.Name.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
            || stay.Location.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase))
        .Where(stay => !savedOnly || SampleData.IsSaved(stay.Id))
        .ToArray();

    private void ResetFilters()
    {
        search = string.Empty;
        savedOnly = false;
    }
}
