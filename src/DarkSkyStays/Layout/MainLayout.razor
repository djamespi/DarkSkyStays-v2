@inherits LayoutComponentBase
@implements IDisposable
@inject PrototypeNavigation Navigation
@inject IJSRuntime JS

<div class="relative min-h-screen">
    <a href="#main-content" class="sr-only z-[60] rounded-xl bg-violet-600 px-4 py-3 text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>
    <div class="stars pointer-events-none fixed inset-0 opacity-60" aria-hidden="true"></div>
    <div class="pointer-events-none fixed -right-40 top-20 h-[600px] w-[600px] rounded-full bg-violet-800/20 blur-[140px]" aria-hidden="true"></div>
    <SiteNavigation Phase="phase" OnOpenPage="OpenPage" />
    <main id="main-content" class="relative" tabindex="-1">
        @Body
    </main>
    <footer class="relative border-t border-white/5 py-10 text-center text-sm text-violet-100/40">
        Dark Sky Stays · Protecting the night, one stay at a time.
    </footer>
</div>

<dialog @ref="noticeDialog" class="coming-soon-dialog rounded-3xl border border-violet-500/20 bg-night p-8 text-starlight shadow-[0_0_80px_#4c1d9555]"
        aria-labelledby="notice-title" aria-describedby="notice-description">
    <h2 id="notice-title" class="font-display text-3xl">@noticeTitle</h2>
    <p id="notice-description" class="mt-4 max-w-md leading-7 text-violet-100/60">@noticeDescription</p>
    <form method="dialog" class="mt-6 flex justify-end">
        <button class="rounded-xl bg-violet-600 px-6 py-3 text-sm font-medium">Back to exploring</button>
    </form>
</dialog>

@code {
    private readonly MoonPhase phase = MoonPhaseService.Calculate(DateTimeOffset.UtcNow);
    private ElementReference noticeDialog;
    private string noticeTitle = string.Empty;
    private string noticeDescription = string.Empty;
    private bool showNotice;

    protected override void OnInitialized() => Navigation.PageRequested += HandlePageRequest;

    private void HandlePageRequest(PrototypePage page)
    {
        SetNotice(page);
        _ = InvokeAsync(StateHasChanged);
    }

    private void OpenPage(PrototypePage page) => SetNotice(page);

    private void SetNotice(PrototypePage page)
    {
        (noticeTitle, noticeDescription) = page switch
        {
            PrototypePage.Stays => ("More stays, coming soon", "Our full dark sky stays directory is on its way. Explore this month's featured stays on the home page in the meantime."),
            PrototypePage.Tours => ("Guided nights, coming soon", "Journeys with astronomers, astrophotographers and storytellers are on their way."),
            _ => ("The Sky Almanac is coming soon", "Soon you can explore the next 30 nights and find your next dark window. Tonight's moon phase is available on the home page.")
        };
        showNotice = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showNotice)
        {
            showNotice = false;
            await JS.InvokeVoidAsync("darkSkyStays.showDialog", noticeDialog);
        }
    }

    public void Dispose() => Navigation.PageRequested -= HandlePageRequest;
}
