<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot/css/app.css" />
    <Content Include="wwwroot/css/app.css" />
    <Watch Remove="wwwroot/css/app.css" />
  </ItemGroup>

  <Target Name="RestoreFrontendDependencies" BeforeTargets="BuildTailwindCss"
          Inputs="$(MSBuildProjectDirectory)/../../package.json;$(MSBuildProjectDirectory)/../../package-lock.json"
          Outputs="$(MSBuildProjectDirectory)/../../node_modules/.package-lock.json"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildTailwind)' != 'false'">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)/../.." />
  </Target>
  <Target Name="BuildTailwindCss" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildTailwind)' != 'false'">
    <Exec Command="npm run css:build" WorkingDirectory="$(MSBuildProjectDirectory)/../.." />
  </Target>
</Project>
