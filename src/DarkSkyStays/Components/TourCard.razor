@using System.Globalization

<article class="flex h-80 overflow-hidden rounded-3xl border border-white/5 bg-white/[0.02] @(Reverse ? "flex-row-reverse" : "")">
    <img src="@Tour.ImageUrl" alt="@Tour.Name" loading="lazy" class="w-1/2 object-cover" />
    <div class="flex w-1/2 flex-col justify-between bg-linear-to-br from-violet-950/40 to-transparent p-10">
        <div>
            <p class="text-sm text-violet-300">@Tour.Location</p>
            <h2 class="mt-2 font-display text-4xl font-light">@Tour.Name</h2>
        </div>
        <div class="flex items-end justify-between gap-4">
            <div class="space-y-1 text-sm text-violet-100/60">
                <p>@Tour.TimeWindow</p>
                <p>Led by @Tour.Guide</p>
            </div>
            <button type="button" @onclick="OnBook"
                    aria-label="@($"Book {Tour.Name}")"
                    class="shrink-0 rounded-xl bg-violet-600 px-6 py-3 text-sm shadow-[0_0_30px_#7c3aed88] transition hover:bg-violet-500">
                Book · &#8369;@Tour.PricePerPerson.ToString("N0", CultureInfo.InvariantCulture)
            </button>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Tour Tour { get; set; } = default!;
    [Parameter] public bool Reverse { get; set; }
    [Parameter] public EventCallback OnBook { get; set; }
}
