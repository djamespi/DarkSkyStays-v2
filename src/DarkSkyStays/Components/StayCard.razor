<article class="flex flex-col rounded-2xl border border-slate-700 bg-slate-900 p-6">
    <p class="text-sm text-sky-300">@Stay.Location</p>
    <h2 class="mt-2 text-xl font-semibold">@Stay.Name</h2>
    <p class="mt-3 grow text-sm leading-6 text-slate-300">@Stay.Description</p>
    <div class="mt-6 flex items-center justify-between gap-4">
        <p><span class="font-semibold">$@Stay.NightlyRate</span><span class="text-sm text-slate-400"> / night</span></p>
        <button type="button" aria-pressed="@(IsSaved ? "true" : "false")"
                aria-label="@(IsSaved ? $"Unsave {Stay.Name}" : $"Save {Stay.Name}")"
                class="rounded-lg border border-slate-600 px-4 py-2 text-sm transition hover:border-sky-300 hover:bg-slate-800"
                @onclick="OnToggleSaved">
            @(IsSaved ? "Saved" : "Save stay")
        </button>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Stay Stay { get; set; } = default!;
    [Parameter] public bool IsSaved { get; set; }
    [Parameter] public EventCallback OnToggleSaved { get; set; }
}
