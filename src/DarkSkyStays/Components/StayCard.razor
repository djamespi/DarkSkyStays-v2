@using System.Globalization

<article class="group overflow-hidden rounded-3xl border border-white/5 bg-white/[0.02] transition hover:border-violet-500/40 hover:shadow-[0_0_50px_#4c1d9555]">
    <div class="relative h-72 overflow-hidden">
        <img src="@Stay.ImageUrl" alt="@Stay.Name" loading="lazy"
             class="h-full w-full object-cover transition duration-700 group-hover:scale-105" />
        <span class="absolute left-4 top-4 rounded-full bg-black/60 px-3 py-1 text-xs text-violet-200 backdrop-blur">@Stay.Tag</span>
    </div>
    <div class="space-y-3 p-6">
        <div class="flex justify-between gap-2">
            <h3 class="font-display text-2xl">@Stay.Name</h3>
            <p class="shrink-0 text-lg">&#8369;@Stay.NightlyRate.ToString("N0", CultureInfo.InvariantCulture)<span class="text-sm text-violet-100/50">/nt</span></p>
        </div>
        <p class="text-sm text-violet-100/50">@Stay.Location</p>
        <div class="flex items-center justify-between border-t border-white/5 pt-3">
            <BortleScale Value="Stay.Bortle" />
            <span class="text-xs text-violet-200/80">SQM @Stay.SkyQuality.ToString("0.0", CultureInfo.InvariantCulture)</span>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Stay Stay { get; set; } = default!;
}
